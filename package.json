{
  "name": "dsh-nextline",
  "version": "0.1.2",
  "description": "Personalized next-message ghost text for DeepSeek Harness",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "locale",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "prepare": "node scripts/build.mjs",
    "prepack": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "license": "MIT",
  "author": "Basspoom (https://github.com/Basspoom)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Basspoom/dsh-nextline.git"
  },
  "homepage": "https://github.com/Basspoom/dsh-nextline#readme",
  "bugs": {
    "url": "https://github.com/Basspoom/dsh-nextline/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "nextline",
    "autocomplete",
    "ghost-text"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
